{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hangar",
  "version": "0.1.0",
  "identifier": "dev.hangar.launcher",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hangar",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0B0D12"
      }
    ],
    "security": {
      "devCsp": null,
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Launcher de vos applications",
    "longDescription": "Hangar distribue, installe, met à jour et lance vos applications.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
